# harness.config — configuración del arnés para tu proyecto
#
# Este archivo lo lee init.sh (y los hooks de .claude/settings.json) para
# saber cómo ejecutar la suite de tests de TU stack. Es la única pieza que
# tienes que tocar para adaptar el arnés a tu lenguaje.

# Comando que ejecuta tu suite de tests. Debe salir con código != 0 si algo
# falla. Déjalo vacío hasta que tengas tests; init.sh avisará pero no fallará.
#
# Ejemplos por stack:
#   TEST_CMD="python3 -m unittest discover -s tests -q"
#   TEST_CMD="pytest -q"
#   TEST_CMD="npm test --silent"
#   TEST_CMD="pnpm -s test"
#   TEST_CMD="go test ./..."
#   TEST_CMD="cargo test --quiet"
#   TEST_CMD="mvn -q test"
TEST_CMD=""

# (Opcional) Comando para contar tests detectados, usado solo para informar.
# Déjalo vacío si no aplica a tu stack.
TEST_COUNT_CMD=""
